{
  "name": "claude-agent-harness",
  "version": "0.0.1",
  "description": "Terminal-based orchestration harness for multi-agent Claude Code workflows",
  "type": "module",
  "private": true,
  "bin": {
    "harness": "./src/cli.ts",
    "harnessd": "./src/daemon/index.ts",
    "harness-mcp": "./src/mcp/server.ts",
    "harness-console": "./src/console/app.tsx"
  },
  "scripts": {
    "dev:cli": "bun run src/cli.ts",
    "dev:daemon": "bun run src/daemon/index.ts",
    "dev:mcp": "bun run src/mcp/server.ts",
    "dev:console": "bun run src/console/app.tsx",
    "build": "bun run build:cli && bun run build:mcp && bun run build:console",
    "build:cli": "bun build src/cli.ts --compile --outfile dist/harness",
    "build:mcp": "bun build src/mcp/server.ts --compile --outfile dist/harness-mcp",
    "build:console": "bun build src/console/app.tsx --compile --outfile dist/harness-console --external react-devtools-core",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "graphology": "^0.25.4",
    "graphology-dag": "^0.4.1",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "marked": "^18.0.3",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "bun-types": "latest",
    "typescript": "^5.6.3"
  }
}
